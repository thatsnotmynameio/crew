# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Environment and secrets
.env
.env.*
!.env.example

# Agents' local state (the shared instructions in .agents/ and .claude/ are committed)
.claude/settings.local.json
.claude/autoharness/
.claude/worktrees/
.remember/

# The crew binary built at the root (go build ./cmd/crew)
/crew

# GoReleaser's output (a local snapshot build)
/dist/

# pnpm packages (the Codacy CLIs)
node_modules/

# Coverage profile (go test -coverprofile), uploaded to Codacy by CI
coverage.out

# The TypeSafe judge's Python project (typesafe/): its environment, the tools'
# caches, and coverage's data and report, written at the repository root
typesafe/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
coverage.xml
.context/compound-engineering/

# Local settings, such as a boss's own .crew/config.local.yaml
*.local*
